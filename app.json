{
  "expo": {
    "name": "Tv Barão",
    "slug": "tv_barao_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tvbarao.mobile",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que a TV Barão use Face ID para desbloquear o aplicativo."
        }
      ],
      "expo-video",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "f5cadbe0-45c9-4265-90b8-dc1053c2eb3e"
      }
    }
  }
}
